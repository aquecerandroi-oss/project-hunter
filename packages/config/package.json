{
  "name": "@hunter/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared lint/type/format presets for PROJECT HUNTER (ESLint quality gates from vibe-coding-toolkit, ruff, pyright, tsconfig).",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/eslint.config.mjs",
    "./eslint/typed": "./eslint/eslint.typed.config.mjs",
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "scripts": {
    "verify:eslint-rules": "node eslint/verify.mjs eslint/eslint-rules/index.cjs",
    "smoke:eslint": "node eslint/smoke.mjs",
    "test": "pnpm run verify:eslint-rules && pnpm run smoke:eslint"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/eslint-plugin-next": "^15.5.25",
    "eslint": "^10.9.1",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "typescript": "^5.6",
    "typescript-eslint": "^8.0.0"
  }
}
