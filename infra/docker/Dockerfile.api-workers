# PROJECT HUNTER — api + workers image.
#
# One image, many roles (ARCHITECTURE.md §1.7): HUNTER_ROLE picks the process
# at runtime via infra/docker/entrypoint.sh. Build once, tag with the commit
# SHA, deploy the same artifact as api, market, scanner, strategy, execution
# or analytics (docs/DEPLOYMENT.md §2).
#
# Build from the repo root:
#   docker build -f infra/docker/Dockerfile.api-workers -t hunter-api:<sha> \
#     --build-arg GIT_SHA=<sha> .

# ---------------------------------------------------------------------------
# Stage 1: builder — resolve and install the uv workspace into a venv.
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# --- Layer 1: workspace manifests only (changes rarely) -------------------
# uv needs every member's pyproject.toml to resolve the workspace graph, but
# not yet its source, so this layer stays cached across source-only edits.
COPY pyproject.toml uv.lock .python-version ./
COPY packages/core/pyproject.toml packages/core/pyproject.toml
COPY packages/exchange-adapters/pyproject.toml packages/exchange-adapters/pyproject.toml
COPY packages/indicators/pyproject.toml packages/indicators/pyproject.toml
COPY packages/risk-core/pyproject.toml packages/risk-core/pyproject.toml
COPY apps/api/pyproject.toml apps/api/pyproject.toml
COPY services/market-worker/pyproject.toml services/market-worker/pyproject.toml
COPY services/scanner-worker/pyproject.toml services/scanner-worker/pyproject.toml
COPY services/strategy-worker/pyproject.toml services/strategy-worker/pyproject.toml
COPY services/execution-worker/pyproject.toml services/execution-worker/pyproject.toml
COPY services/analytics-worker/pyproject.toml services/analytics-worker/pyproject.toml

# Third-party dependencies only — no workspace member source exists yet, so
# skip installing the (editable) workspace packages themselves.
RUN uv sync --all-packages --frozen --no-dev --no-install-workspace

# --- Layer 2: full source, then finish the sync ----------------------------
COPY packages/core packages/core
COPY packages/exchange-adapters packages/exchange-adapters
COPY packages/indicators packages/indicators
COPY packages/risk-core packages/risk-core
COPY apps/api apps/api
COPY services/market-worker services/market-worker
COPY services/scanner-worker services/scanner-worker
COPY services/strategy-worker services/strategy-worker
COPY services/execution-worker services/execution-worker
COPY services/analytics-worker services/analytics-worker

RUN uv sync --all-packages --frozen --no-dev

# ---------------------------------------------------------------------------
# Stage 2: runtime — slim image, non-root, no uv/build toolchain.
# ---------------------------------------------------------------------------
FROM python:3.12-slim-bookworm AS runtime

ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="project-hunter-api-workers" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.source="https://github.com/project-hunter/project-hunter"

ENV PATH=/app/.venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HUNTER_ROLE=api \
    HUNTER_RELEASE=${GIT_SHA}

RUN groupadd --gid 10001 hunter \
    && useradd --uid 10001 --gid hunter --no-create-home --shell /usr/sbin/nologin hunter

WORKDIR /app

COPY --from=builder /app/.venv /app/.venv
COPY packages/core packages/core
COPY packages/exchange-adapters packages/exchange-adapters
COPY packages/indicators packages/indicators
COPY packages/risk-core packages/risk-core
COPY apps/api apps/api
COPY services/market-worker services/market-worker
COPY services/scanner-worker services/scanner-worker
COPY services/strategy-worker services/strategy-worker
COPY services/execution-worker services/execution-worker
COPY services/analytics-worker services/analytics-worker
COPY infra/migrations infra/migrations
COPY infra/scripts infra/scripts
COPY infra/docker/entrypoint.sh infra/docker/entrypoint.sh
COPY infra/docker/healthcheck.py infra/docker/healthcheck.py

RUN chmod +x infra/docker/entrypoint.sh \
    && chown -R hunter:hunter /app

USER hunter

EXPOSE 8000 8001

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python", "infra/docker/healthcheck.py"]

ENTRYPOINT ["/app/infra/docker/entrypoint.sh"]
