# PROJECT HUNTER — variáveis de ambiente (exemplo; nunca commitar valores reais)

# ---- Ambiente ----
HUNTER_ENV=development                 # development | staging | production
HUNTER_ROLE=all                        # api | market | scanner | strategy | execution | analytics | all
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000       # CORS allowlist (uma ou mais origens separadas por vírgula)
API_URL=http://localhost:8000          # usado pelo web server-side
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
API_PORT=8000                          # porta HTTP do processo api (uvicorn)
HEALTH_PORT=8001                       # porta de /health, /ready, /metrics nos workers (HUNTER_ROLE != api)
CORS_ALLOWED_ORIGINS=http://localhost:3000   # allowlist exata do middleware CORS da api (uma ou mais, separadas por vírgula)
RATE_LIMIT_PER_MINUTE=120              # limite por endereço (middleware, antes do roteamento) — cobre a superfície não autenticada
RATE_LIMIT_PER_MINUTE_PRINCIPAL=600    # limite por principal autenticado (aplicado após a verificação do token); uma conta atrás de várias origens divide este balde
READY_CHECK_TIMEOUT_S=3.0              # timeout por dependência (Postgres/Redis) em /ready
FORWARDED_ALLOW_IPS=127.0.0.1          # em produção, definir para o ingress da plataforma — só esse IP tem X-Forwarded-For confiado pelo uvicorn
METRICS_TOKEN=                         # se definido, /metrics exige "Authorization: Bearer <token>"; vazio em staging/produção desativa /metrics (404)
MAX_REQUEST_BODY_BYTES=1048576         # limite de corpo em /api/*: checado no Content-Length antes de ler e nos bytes efetivamente recebidos (upload chunked não declara tamanho); o webhook do Clerk tem limite próprio, menor
JWKS_REFRESH_COOLDOWN_S=60             # intervalo mínimo entre dois refetches do JWKS disparados por um "kid" desconhecido (anti-amplificação)
JWKS_MAX_STALE_S=86400                 # por quanto tempo o JWKS em cache continua valendo enquanto todo refetch falha; passado isso a autenticação responde 503 em vez de aceitar chave que ninguém conseguiu confirmar
WS_REVALIDATE_INTERVAL_S=60            # de quanto em quanto tempo um WebSocket aberto revalida a associação do principal (perda de acesso fecha com 4403)
WS_HANDSHAKES_PER_MINUTE=30            # handshakes /ws por endereço por minuto, checado antes do accept(); excedente é recusado com 4429
WS_MAX_CONNECTIONS_PER_PRINCIPAL=5     # conexões /ws vivas por principal neste processo; excedente fecha com 4429
WEBHOOK_CLAIM_STALE_S=300              # tempo que um claim em processed_events pode ficar inacabado antes que uma redelivery possa retomá-lo (recuperação de crash entre o claim e o efeito)

# ---- Banco e cache ----
DATABASE_URL=postgresql+asyncpg://hunter:hunter@localhost:5432/hunter
# DATABASE_URL_MIGRATIONS: DSN do dono do schema (conexão direta, sem pooler,
# para Alembic e os scripts em infra/scripts/ que escrevem como dono — ver
# docs/DEPLOYMENT.md §3.4). Só faz sentido no host (rodando `alembic` direto)
# ou em CI; nunca no `.env` da VPS — lá ela pertence só às âncoras
# `x-owner-env`/`x-prod-owner-env` dos serviços `migrate`/`ops`
# (infra/docker/docker-compose.yml, infra/vps/docker-compose.prod.yml).
# `infra/vps/compose.sh` recusa subir se esta chave existir no `.env` da VPS
# (T3.15e) — descomente só localmente/no host, nunca copie para lá.
# DATABASE_URL_MIGRATIONS=postgresql://hunter:hunter@localhost:5432/hunter
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=5                         # tamanho do pool de conexões do engine assíncrono
DB_MAX_OVERFLOW=5                      # conexões extras permitidas além do pool_size sob carga

# ---- Auth (Clerk) ---- (CLERK_SECRET_KEY, CLERK_WEBHOOK_SECRET, CLERK_JWKS_URL e CLERK_ISSUER são
# obrigatórios em staging/production: o processo se recusa a subir sem eles)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=                        # https://<instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=

# ---- Segredos de aplicação ----
AUTH_SECRET=                           # assinatura de tokens internos (WS tickets, convites)
HUNTER_MASTER_KEY=                     # dev: base64 de 32 bytes; prod: usar KMS
KMS_KEY_ID=                            # prod (Fase 3)

# ---- Observabilidade e produto ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- LLM (Fase 2) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# OpenAI (segundo provedor LLM, Fase 2 — ADR 0002). Chave só aqui, nunca no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Provedor e modelo padrão da camada LLM (anthropic | openai); modelo vazio = padrão do provedor
LLM_PROVIDER=anthropic
LLM_MODEL=

# ---- Exchanges (opcionais no MVP; só elevam rate limit de dados públicos; NUNCA com permissão de saque) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ---- Feature flags de sistema ----
ENABLE_LIVE_TRADING=false
ENABLE_SOCIAL_INTELLIGENCE=false
ENABLE_ONCHAIN=false
ENABLE_STRIPE=false
ENABLE_LLM_ANALYSIS=false
ENABLE_ARENA=false
ENABLE_BACKTESTS=false
ENABLE_PAPER_AUTONOMY=false            # T3.14/T4.72: execution-worker consome shadow.signals.emitted e admite sozinho.
                                        # Default false em produção até TODA linha do checklist de docs/ACTIVATION.md §8
                                        # estar verde (beta por mercado, agents habilitado, risk_profile, MTM, backup, kill
                                        # switch); ligar é decisão do Everton, nunca automática.
SYSTEM_KILL_SWITCH=ACTIVE              # ACTIVE | WARNING | TRADING_DISABLED | EMERGENCY

# ---- Dimensionamento ----
MARKET_UNIVERSE_SIZE=200
MARKET_STALE_AFTER_S=10                # idade do ts da exchange por componente ticker/book/mark; TTL do deriv (600s) nao mede frescor
BOOK_DEPTH=25
TICK_COALESCE_MS=250
FEATURE_THROTTLE_MS=1000
RADAR_PUSH_MS=1000
RETENTION_CANDLES_1M_DAYS=90
RETENTION_FEATURE_SNAPSHOTS_DAYS=14

# ---- market-worker (docs/plans/M1.md T1.3) ----
MARKET_EXCHANGE_CODE=binance           # qual ExchangeAdapter o worker constrói (hunter_market_worker.config.build_adapter); só "binance" existe no M1
MARKET_UNIVERSE_ALLOWLIST=[]           # array JSON de símbolos sempre monitorados (ex.: ["BTCUSDT","ETHUSDT"]), mesmo fora do top MARKET_UNIVERSE_SIZE
MARKET_UNIVERSE_BLOCKLIST=[]           # array JSON de símbolos nunca monitorados, mesmo dentro do top MARKET_UNIVERSE_SIZE
MARKET_UNIVERSE_REFRESH_S=900          # cadência do recálculo do universo monitorado (PIPELINE.md §1: 15 min)
MARKET_OI_POLL_S=300                   # cadência do poll REST de open interest -> open_interest_history
MARKET_SNAPSHOT_INTERVAL_S=60          # cadência da escrita de market_snapshots (uma linha por mercado monitorado por minuto)

# ---- Meme radar — orçamentos por fonte ----
MEME_PUMPFUN_REST_BUDGET_60S=60        # teto de GET /coins/{mint} por minuto no frontend-api-v3.pump.fun; 60 é o medido por IP sozinho (T4.0/T4.1); baixar quando o IP é compartilhado (T4.75: 34/60 já deu 429 em ~12% dos polls)

# ---- Meme radar — portão de evento (T4.52b-3, docs/RISK_ENGINE_MEME.md §9) ----
MEME_EVENT_GATE=off                    # off | shadow | on — shadow avalia e conta, nunca insere; on escreve de verdade
SOLANA_RPC_WS_URL=                     # vazio = deriva de SOLANA_RPC_URL (https->wss/http->ws) ou o RPC público
MEME_EVENT_COMMITMENT=confirmed        # confirmed | processed — processed nunca decide sozinho (doutrina §8.2)
MEME_EVENT_GATE_MAX_MINTS=150          # teto de assinaturas WS simultâneas (raio de explosão, plan-T4.52b.md §4)

# ---- Meme radar — pista de lançamento (T4.67a, EXP-M18, docs/RISK_ENGINE_MEME.md §9 "Pista de lançamento") ----
MEME_LAUNCH_LANE=off                   # off | paper | on — paper/on: propõe launch_v0/1 e abre/fecha aposta de papel a cada create; usa SOLANA_RPC_WS_URL e MEME_EVENT_COMMITMENT acima (os mesmos do radar)
#                                        o executor lê a MESMA variável: só em on ele compra pelo perfil de lançamento (T4.67b, docs/RISK_ENGINE_MEME.md §18, docs/ACTIVATION.md 9h)
MEME_LAUNCH_MAX_OPEN=2                 # teto de posições de lançamento (abertas + pendentes), separado de MEME_MAX_OPEN_POSITIONS
MEME_LAUNCH_TICKET_SOL=0.01            # bilhete de um lançamento; nunca acima de MEME_MAX_SOL_PER_TRADE; o piso MEME_MIN_TRADE_SOL segue o bilhete
MEME_LAUNCH_PRIORITY_FLOOR_MICRO_LAMPORTS=1000000   # piso da prioridade no lançamento (0,0004 SOL com 400k CU); max(p75, piso) limitado por MEME_PRIORITY_FEE_MAX_SOL
MEME_LAUNCH_BUY_SLIPPAGE_PCT=10        # tolerância da instrução de compra no lançamento, por cento, (0, 20]
MEME_LAUNCH_SKIP_SIMULATION=false      # true pula o simulateTransaction antes de assinar (~100 ms); o preflight do nó continua — risco declarado em ACTIVATION 9h
MEME_LAUNCH_MAX_PARTICIPATION_PCT=0.10 # fração do SOL real já na curva que o bilhete pode ser (o 1 % do perfil exigiria 1 SOL no primeiro segundo)
MEME_LAUNCH_MAX_AGE_S=5                # idade máxima da moeda na admissão, do carimbo do create; mais velha => launch_proposal_stale

# ---- Meme executor — pausa por mint depois de perda (T4.78, docs/RISK_ENGINE_MEME.md §4 check 28, EXP-M21) ----
MEME_MINT_COOLDOWN_AFTER_LOSS_S=300     # segundos sem compra nova num mint cuja última posição real fechou com pnl_sol < 0 (mesa e lançamento; vendas nunca); 0 desliga; ilegível/negativo recusa o boot pelo nome

# ---- Meme executor — saída por evento (T4.63, docs/RISK_ENGINE_MEME.md §9 "Saída por evento") ----
MEME_EVENT_EXITS=off                   # off | on — on: o executor assina a curva de cada posição aberta no seu próprio WS e vende no evento; o tick de 10 s continua como reserva
#                                        usa SOLANA_RPC_WS_URL e MEME_EVENT_COMMITMENT acima (os mesmos do radar); qualquer outro valor lê como off

# ---- Mesa spot/1 — sinal do Lab (Binance) executado na Solana (T4.74, docs/design/spot1-lab-solana.md §6, docs/ACTIVATION.md 9j) ----
SPOT1_ENABLED=false                    # nasce false; só liga com ENABLE_MEME_LIVE_TRADING=true e o signer presente, senão spot1.mode = inert:<motivo>
SPOT1_STRATEGY_VERSION=v14             # mean_reversion/v14; qualquer outra versão de mean_reversion serve, outra estratégia recusa spot1_strategy_unsupported no boot
SPOT1_TICKET_SOL=0.05                  # ficha fixa, clampada por MEME_MAX_SOL_PER_TRADE e pelo escopo (meme_gates.json)
SPOT1_MAX_OPEN=3                       # posições lane=spot abertas + pendentes; contam também no MEME_MAX_OPEN_POSITIONS global
SPOT1_MAX_SIGNAL_AGE_S=180             # idade máxima do sinal na admissão (max_entry_delay_s do sinal + uma vela)
SPOT1_MAX_HOLD_S=14400                 # teto do horizonte do sinal (4 h)
SPOT1_MAX_PARITY_PCT=0.03              # |jup_usd/bin_usd - 1| máximo na decisão (fração, DATABASE.md §1)
SPOT1_MAX_IMPACT_PCT=0.005             # impacto máximo da cotação de compra
SPOT1_MAX_COST_R=0.5                   # custo estimado da operação (2 pernas + spread) sobre r_unit_sol
SPOT1_MARK_S=20                        # cadência da marca das posições abertas pela Jupiter
SPOT1_EXIT_SLIPPAGE_BPS=50             # slippage da venda em condição normal
SPOT1_PANIC_SLIPPAGE_BPS=300           # slippage a partir da 3ª tentativa de venda, ou desde a 1ª em stop/emergency
SPOT1_PRIORITY_FEE_MAX_LAMPORTS=100000 # teto de prioridade por perna; 200000 já estoura SPOT1_MAX_COST_R a 0,05 SOL (T4.74-2)
SPOT1_REFUTE_MIN_TRADES=20             # nº de operações fechadas para a refutação avaliar expectância
SPOT1_REFUTE_MAX_LOSS_SOL=0.15         # Σ pnl_sol negativo que refuta a pista a qualquer momento
SPOT1_CONSECUTIVE_STOPS_PAUSE_S=7200   # pausa de qualidade após 3 stops seguidos (2 h)
SPOT1_REFUTATION_RESET_AT=             # ISO vazio; só uma data nova aqui (ou SPOT1_STRATEGY_VERSION nova) reabre a pista depois de "refuted"
