# PROJECT HUNTER — variáveis de ambiente (exemplo; nunca commitar valores reais)

# ---- Ambiente ----
HUNTER_ENV=development                 # development | staging | production
HUNTER_ROLE=all                        # api | market | scanner | strategy | execution | analytics | all
LOG_LEVEL=INFO
WEB_ORIGIN=http://localhost:3000       # CORS allowlist (uma ou mais origens separadas por vírgula)
API_URL=http://localhost:8000          # usado pelo web server-side
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
API_PORT=8000                          # porta HTTP do processo api (uvicorn)
HEALTH_PORT=8001                       # porta de /health, /ready, /metrics nos workers (HUNTER_ROLE != api)
CORS_ALLOWED_ORIGINS=http://localhost:3000   # allowlist exata do middleware CORS da api (uma ou mais, separadas por vírgula)
RATE_LIMIT_PER_MINUTE=120              # limite por endereço (middleware, antes do roteamento) — cobre a superfície não autenticada
RATE_LIMIT_PER_MINUTE_PRINCIPAL=600    # limite por principal autenticado (aplicado após a verificação do token); uma conta atrás de várias origens divide este balde
READY_CHECK_TIMEOUT_S=3.0              # timeout por dependência (Postgres/Redis) em /ready
FORWARDED_ALLOW_IPS=127.0.0.1          # em produção, definir para o ingress da plataforma — só esse IP tem X-Forwarded-For confiado pelo uvicorn
METRICS_TOKEN=                         # se definido, /metrics exige "Authorization: Bearer <token>"; vazio em staging/produção desativa /metrics (404)
MAX_REQUEST_BODY_BYTES=1048576         # limite de corpo em /api/*: checado no Content-Length antes de ler e nos bytes efetivamente recebidos (upload chunked não declara tamanho); o webhook do Clerk tem limite próprio, menor
JWKS_REFRESH_COOLDOWN_S=60             # intervalo mínimo entre dois refetches do JWKS disparados por um "kid" desconhecido (anti-amplificação)
JWKS_MAX_STALE_S=86400                 # por quanto tempo o JWKS em cache continua valendo enquanto todo refetch falha; passado isso a autenticação responde 503 em vez de aceitar chave que ninguém conseguiu confirmar
WS_REVALIDATE_INTERVAL_S=60            # de quanto em quanto tempo um WebSocket aberto revalida a associação do principal (perda de acesso fecha com 4403)
WS_HANDSHAKES_PER_MINUTE=30            # handshakes /ws por endereço por minuto, checado antes do accept(); excedente é recusado com 4429
WS_MAX_CONNECTIONS_PER_PRINCIPAL=5     # conexões /ws vivas por principal neste processo; excedente fecha com 4429
WEBHOOK_CLAIM_STALE_S=300              # tempo que um claim em processed_events pode ficar inacabado antes que uma redelivery possa retomá-lo (recuperação de crash entre o claim e o efeito)

# ---- Banco e cache ----
DATABASE_URL=postgresql+asyncpg://hunter:hunter@localhost:5432/hunter
DATABASE_URL_MIGRATIONS=postgresql://hunter:hunter@localhost:5432/hunter   # conexão direta (sem pooler) para Alembic
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=5                         # tamanho do pool de conexões do engine assíncrono
DB_MAX_OVERFLOW=5                      # conexões extras permitidas além do pool_size sob carga

# ---- Auth (Clerk) ---- (CLERK_SECRET_KEY, CLERK_WEBHOOK_SECRET, CLERK_JWKS_URL e CLERK_ISSUER são
# obrigatórios em staging/production: o processo se recusa a subir sem eles)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWKS_URL=                        # https://<instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=

# ---- Segredos de aplicação ----
AUTH_SECRET=                           # assinatura de tokens internos (WS tickets, convites)
HUNTER_MASTER_KEY=                     # dev: base64 de 32 bytes; prod: usar KMS
KMS_KEY_ID=                            # prod (Fase 3)

# ---- Observabilidade e produto ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---- LLM (Fase 2) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# OpenAI (segundo provedor LLM, Fase 2 — ADR 0002). Chave só aqui, nunca no frontend.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Provedor e modelo padrão da camada LLM (anthropic | openai); modelo vazio = padrão do provedor
LLM_PROVIDER=anthropic
LLM_MODEL=

# ---- Exchanges (opcionais no MVP; só elevam rate limit de dados públicos; NUNCA com permissão de saque) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ---- Feature flags de sistema ----
ENABLE_LIVE_TRADING=false
ENABLE_SOCIAL_INTELLIGENCE=false
ENABLE_ONCHAIN=false
ENABLE_STRIPE=false
ENABLE_LLM_ANALYSIS=false
ENABLE_ARENA=false
ENABLE_BACKTESTS=false
SYSTEM_KILL_SWITCH=ACTIVE              # ACTIVE | WARNING | TRADING_DISABLED | EMERGENCY

# ---- Dimensionamento ----
MARKET_UNIVERSE_SIZE=200
MARKET_STALE_AFTER_S=10                # idade do ts da exchange por componente ticker/book/mark; TTL do deriv (600s) nao mede frescor
BOOK_DEPTH=25
TICK_COALESCE_MS=250
FEATURE_THROTTLE_MS=1000
RADAR_PUSH_MS=1000
RETENTION_CANDLES_1M_DAYS=90
RETENTION_FEATURE_SNAPSHOTS_DAYS=14

# ---- market-worker (docs/plans/M1.md T1.3) ----
MARKET_EXCHANGE_CODE=binance           # qual ExchangeAdapter o worker constrói (hunter_market_worker.config.build_adapter); só "binance" existe no M1
MARKET_UNIVERSE_ALLOWLIST=[]           # array JSON de símbolos sempre monitorados (ex.: ["BTCUSDT","ETHUSDT"]), mesmo fora do top MARKET_UNIVERSE_SIZE
MARKET_UNIVERSE_BLOCKLIST=[]           # array JSON de símbolos nunca monitorados, mesmo dentro do top MARKET_UNIVERSE_SIZE
MARKET_UNIVERSE_REFRESH_S=900          # cadência do recálculo do universo monitorado (PIPELINE.md §1: 15 min)
MARKET_OI_POLL_S=300                   # cadência do poll REST de open interest -> open_interest_history
MARKET_SNAPSHOT_INTERVAL_S=60          # cadência da escrita de market_snapshots (uma linha por mercado monitorado por minuto)
